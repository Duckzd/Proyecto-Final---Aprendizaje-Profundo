# --- Python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# --- Sistema operativo ---
.DS_Store
Thumbs.db

# --- Artefactos generados (se regeneran al ejecutar main.py o el notebook) ---
assets/
*.pt
*.npz

